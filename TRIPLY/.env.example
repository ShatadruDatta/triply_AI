# Server-only
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Dev only: use the local Inngest Dev Server (no event/signing keys)
INNGEST_DEV=1

GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-4-hydrogen)
GEMINI_MODEL=
# Optional but recommended: destination autocomplete and map pins
GOOGLE_PLACES_API_KEY=
# Trip photos (Unsplash demo tier: 50 requests/hour)
UNSPLASH_ACCESS_KEY=
# Dev only: lets the dev login shortcut call the API without a Clerk session
DEV_BYPASS_AUTH=

# Client-safe
# Optional: API base URL. In dev it defaults to the Expo dev server (same host as Metro).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: used as a fallback when Gemini fails or is not configured
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: monthly generation limit in units (3 per trip). Defaults to 9 (3 trips).
QUOTA_LIMIT_UNITS=

# Client-safe: Sentry DSN, used by the app and (as a fallback source) the server. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: speech-to-text model for the assistant mic (default gpt-transcribe)
OPENAI_TRANSCRIBE_MODEL=

# Local builds: skip the Sentry source-map upload. For release builds, remove this and set
# SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN (EAS environment variables).
SENTRY_DISABLE_AUTO_UPLOAD=true
# Assistant prompts and replies are only attached to Sentry AI spans outside production.
# Set to 1 to record them in production too (they are users' conversations).
SENTRY_RECORD_AI_CONTENT=
